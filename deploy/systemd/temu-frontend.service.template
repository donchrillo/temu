[Unit]
Description=TEMU ERP React Frontend (Preview)
After=network.target

[Service]
Type=simple
User=chx
Group=chx
WorkingDirectory=/home/chx/jtl_erp/frontend-react
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run preview -- --host 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
